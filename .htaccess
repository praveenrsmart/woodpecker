<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /wood/

# Block web access to data files
RewriteRule ^data/ - [F,L]

# API requests -> PHP backend
RewriteRule ^api(?:/(.*))?$ api/index.php [QSA,L]

# Serve existing files (JS, CSS, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React SPA fallback
RewriteRule ^ index.html [L]
</IfModule>

# Protect SQLite database if data folder is inside public_html
<FilesMatch "\.(db|sqlite|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
